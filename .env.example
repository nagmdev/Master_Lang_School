# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real secrets.
#
# node --env-file-if-exists=.env server.js   (already wired as `npm run dev`)

# --- Admin dashboard (required to sign in to /admin.html) -------------------
# In development these fall back to insecure defaults with a console warning.
# In production (VERCEL=1 or NODE_ENV=production) both are REQUIRED — the
# server refuses to authenticate rather than accept a weak default.
MS_ADMIN_PASSWORD=
MS_SESSION_SECRET=

# Optional — the academic-year prefix on admissions reference numbers
# (e.g. 2026-1800). Defaults to 2026.
MS_ACADEMIC_YEAR=

# --- Email (Resend) ----------------------------------------------------------
# Get a key at https://resend.com — free tier is enough for a school's volume.
# Without this key: admissions and career applications still SAVE fine (you'll
# just see a console warning and no alert email). The Contact form has nothing
# to save, so without this key it correctly tells the visitor their message
# was NOT delivered instead of lying with a "sent" screen.
RESEND_API_KEY=

# Optional — who receives admissions alerts AND Contact-form messages.
# Defaults to admission@masters-edu.com.
MS_NOTIFY_EMAIL=

# Optional — who receives "new job application" HR alerts (careers.html /
# apply-*.html / the embedded Careers section). Defaults to MS_NOTIFY_EMAIL.
MS_HR_NOTIFY_EMAIL=

# Optional — verified sender, e.g. "Masters School <no-reply@masters-edu.com>".
# Requires verifying your domain in Resend first. Leave unset to use Resend's
# shared test sender (onboarding@resend.dev), which works immediately but is
# rate-limited and looks less trustworthy to recipients.
MS_FROM_EMAIL=

# Optional — your live domain, used to build the "view in dashboard" link
# inside alert emails, e.g. https://masters-edu.com
MS_SITE_URL=

# --- Database (required in production; local dev works without it) ---------
# Vercel Postgres / Neon / Supabase / Railway all work. Without this, the app
# uses the local JSON+disk store, which is fine for development but MUST NOT
# be used in production (Vercel's filesystem is ephemeral — see DEPLOY.md).
DATABASE_URL=
